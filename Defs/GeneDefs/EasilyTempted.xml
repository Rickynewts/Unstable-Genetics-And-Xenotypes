<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_EasilyTempted</defName>
    <label>Easily tempted</label>
    <labelShortAdj>easily tempted</labelShortAdj>
    <description>Carriers of this gene are easily tempted by substances.</description>
    <!--自定义图标-->
   <modExtensions>
    <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
      <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
     </li>
   </modExtensions>
   <!--强制特性-->
   <forcedTraits>
    <li>
     <def>DrugDesire</def>
     <degree>2</degree>
    </li>
   </forcedTraits>
    <!--UI-->
    <iconPath>UI/Genes/Gene_EasilyTempted</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>1</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>