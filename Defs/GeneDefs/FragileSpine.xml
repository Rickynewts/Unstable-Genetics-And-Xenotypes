<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_FragileSpine</defName>
    <label>Fragile spine</label>
    <labelShortAdj>fragile spine</labelShortAdj>
    <description>Carriers of this gene have poorly developed, brittle vertebrae that can barely withstand any impact.</description>
    <!--UI-->
    <iconPath>UI/Genes/Gene_FragileSpine</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--自定义图标-->
   <modExtensions>
     <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
       <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
     </li>
   </modExtensions>
    <!--添加乘法修正-->
    <statFactors>
      <IncomingDamageFactor>2</IncomingDamageFactor>
    </statFactors>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>2</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>