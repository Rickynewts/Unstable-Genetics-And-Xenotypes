<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_Neurasthenia</defName>
    <label>Neurasthenia</label>
    <labelShortAdj>neurasthenic</labelShortAdj>
    <description>Carriers of this gene alternate between nervous overstimulation and exhaustion, and sleep poorly.</description>
    <!--UI-->
    <iconPath>UI/Genes/Gene_Neurasthenia</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>100</displayOrderInCategory>
    <!--自定义图标-->
   <modExtensions>
     <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
       <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
     </li>
   </modExtensions>
    <!--添加乘法修正-->
    <statFactors>
      <RestRateMultiplier>0.6</RestRateMultiplier>
    </statFactors>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>2</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>