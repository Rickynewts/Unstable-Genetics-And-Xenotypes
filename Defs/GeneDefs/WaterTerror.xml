<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_WaterTerror</defName>
    <label>Water terror</label>
    <labelShortAdj>aquaphobic</labelShortAdj>
    <description>Carriers of this gene have an instinctive terror of water.</description>
    <customEffectDescriptions>
     <li>Mood penalty when rained on</li>
     <li>Mood penalty when standing in water</li>
     <li>Gains "water terror panic" while in water</li>
    </customEffectDescriptions>
    <!--UI-->
    <iconPath>UI/Genes/Gene_WaterTerror</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>110</displayOrderInCategory>
    <geneClass>UnstableGenetics.Gene_WaterTerror</geneClass>
    <modExtensions>
      <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
        <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
      </li>
    </modExtensions>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>2</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>