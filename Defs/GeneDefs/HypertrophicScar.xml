<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_HypertrophicScar</defName>
    <label>Hypertrophic scarring</label>
    <labelShortAdj>scar-prone</labelShortAdj>
    <description>Carriers of this gene heal with excessive tissue growth, leaving permanent scars.</description>
    <customEffectDescriptions>
      <li>Higher chance of permanent scars from injuries</li>
    </customEffectDescriptions>
    <!--UI-->
    <iconPath>UI/Genes/Gene_HypertrophicScar</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>120</displayOrderInCategory>
    <modExtensions>
      <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
        <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
      </li>
    </modExtensions>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>1</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>