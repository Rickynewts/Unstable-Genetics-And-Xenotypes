<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <GeneDef>
    <defName>UG_NeurodegenerativeDisease</defName>
    <label>Neurodegeneration</label>
    <labelShortAdj>neurodegenerative</labelShortAdj>
    <description>Carriers of this gene suffer gradual degeneration of the brain.</description>
    <geneClass>UnstableGenetics.Gene_NeurodegenerativeDisease</geneClass>
    <customEffectDescriptions>
      <li>Develops Alzheimer's</li>
    </customEffectDescriptions>
    <!--自定义背景-->
    <modExtensions>
      <li Class="GeneBackgroundFramework.GeneBackgroundExtension">
        <backgroundPath>UI/Genes/GeneBackground_UnstableGene</backgroundPath>
      </li>
    </modExtensions>
    <!--UI-->
    <iconPath>UI/Genes/Gene_NeurodegenerativeDisease</iconPath>
    <displayCategory>UnstableGenetics</displayCategory>
    <displayOrderInCategory>110</displayOrderInCategory>
    <!--复杂度-->
    <biostatCpx>1</biostatCpx>
    <!--代谢率-->
    <biostatMet>2</biostatMet>
    <!--生成权重-->
    <selectionWeight>0.5</selectionWeight>
  </GeneDef>
</Defs>