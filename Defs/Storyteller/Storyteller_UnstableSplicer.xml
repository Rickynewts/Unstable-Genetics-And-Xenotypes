<?xml version="1.0" encoding="utf-8" ?>
<Defs>
  <StorytellerDef ParentName="BaseStoryteller">
    <defName>UG_Splicer</defName>
    <label>Vex the Splicer</label>
    <description>Vex doesn't care whether your colony survives the winter. He only cares whether the lab notes look good.\n\nEvents come without rhythm: days of calm, then raids, disease and bad luck all at once in a single night. He favors biological experiments, so diseases and genetic defects are more common than elsewhere.\n\nWarning: Vex's script is not balanced. You either live on as a paper, or die as a data point.</description>
    <portraitLarge>UI/HeroArt/Storyteller/UnstableSplicer</portraitLarge>
    <portraitTiny>UI/HeroArt/Storyteller/UnstableSplicer_Small</portraitTiny>
    <listOrder>45</listOrder>
    <comps>

      <!--主随机事件流-->
      <li Class="StorytellerCompProperties_RandomMain">
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
        <minDaysPassed>1</minDaysPassed>
        <spaceMtbDayFactor>2</spaceMtbDayFactor>
        <spaceMinSpacingDays>2</spaceMinSpacingDays>
        <mtbDays>1.25</mtbDays>
        <maxThreatBigIntervalDays>12</maxThreatBigIntervalDays>
        <minIncChancePopulationIntentFactor>0.2</minIncChancePopulationIntentFactor>
        <randomPointsFactorRange>0.4~1.6</randomPointsFactorRange>
        <skipThreatBigIfRaidBeacon>true</skipThreatBigIfRaidBeacon>
        <categoryWeights>
          <Misc>3.4</Misc>
          <ThreatBig>1.3</ThreatBig>
          <OrbitalVisitor>1.0</OrbitalVisitor>
          <FactionArrival>2.2</FactionArrival>
          <ThreatSmall>0.7</ThreatSmall>
          <ShipChunkDrop>0.22</ShipChunkDrop>
        </categoryWeights>
      </li>

      <!--疾病频率-->
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseHuman</category>
        <minDaysPassed>2</minDaysPassed>
      </li>
      <li Class="StorytellerCompProperties_CategoryMTB">
        <category>DiseaseHuman</category>
        <minDaysPassed>15</minDaysPassed>
        <mtbDays>55</mtbDays>
      </li>
      <li Class="StorytellerCompProperties_Disease">
        <category>DiseaseAnimal</category>
        <minDaysPassed>2</minDaysPassed>
      </li>

      <!--袭击信标-->
      <li Class="StorytellerCompProperties_ThreatsGenerator">
        <allowedTargetTags>
          <li>Map_RaidBeacon</li>
        </allowedTargetTags>
        <parms>
          <allowedThreats>Raids</allowedThreats>
          <onDays>3.0</onDays>
          <offDays>6.0</offDays>
          <minSpacingDays>0.6</minSpacingDays>
          <numIncidentsRange>1~2</numIncidentsRange>
          <minThreatPoints>500</minThreatPoints>
        </parms>
      </li>

      <!--殖民地杂项事件-->
      <li Class="StorytellerCompProperties_CategoryMTB">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Map_PlayerHome</li>
        </allowedTargetTags>
        <minDaysPassed>4</minDaysPassed>
        <mtbDays>4</mtbDays>
      </li>

      <!--商队与临时地图-->
      <li Class="StorytellerCompProperties_CategoryIndividualMTBByBiome">
        <category>Misc</category>
        <allowedTargetTags>
          <li>Caravan</li>
          <li>Map_TempIncident</li>
        </allowedTargetTags>
      </li>

      <!--任务：非 Royalty-->
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>10</onDays>
        <numIncidentsRange>1</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>0.2</minSpacingDays>
        <disableIfAnyModActive>
          <li>Ludeon.RimWorld.Royalty</li>
        </disableIfAnyModActive>
      </li>

      <!--任务：Royalty-->
      <li Class="StorytellerCompProperties_RandomQuest">
        <category>GiveQuest</category>
        <allowedTargetTags>
          <li>World</li>
        </allowedTargetTags>
        <onDays>12</onDays>
        <numIncidentsRange>1~3</numIncidentsRange>
        <acceptFractionByDaysPassedCurve>
          <points>
            <li>(8, 0)</li>
            <li>(15, 1)</li>
          </points>
        </acceptFractionByDaysPassedCurve>
        <minSpacingDays>0.2</minSpacingDays>
      </li>
    </comps>
  </StorytellerDef>
</Defs>